FILESEXTRAPATHS:prepend := "${THISDIR}/phosphor-ipmi-host:"

DEPENDS:append:zynq = " zynq-yaml-config"

PACKAGECONFIG:remove = " i2c-allowlist"

EXTRA_OEMESON:zynq = " \
    -Dsensor-yaml-gen=${STAGING_DIR_HOST}${datadir}/zynq-yaml-config/ipmi-sensors.yaml \
    -Dfru-yaml-gen=${STAGING_DIR_HOST}${datadir}/zynq-yaml-config/ipmi-fru-read.yaml \
    "
